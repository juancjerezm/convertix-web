---
export interface Props {
  title: string
  description: string
  ogImage?: string
  url?: string
}

// biome-ignore lint/correctness/noUnusedVariables: used in Astro template
const { title, description, ogImage, url } = Astro.props
// biome-ignore lint/correctness/noUnusedVariables: used in Astro template
const defaultOgImage = ogImage || '/og-image.png'
// biome-ignore lint/correctness/noUnusedVariables: used in Astro template
const siteUrl = url || 'https://convertixweb.app'
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content="página web Colombia, diseño web Colombia, landing page Colombia, chatbot WhatsApp Colombia, automatización Colombia, desarrollo web Colombia, IA para negocios" />

<!-- Canonical -->
<link rel="canonical" href={siteUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={defaultOgImage.startsWith('http') ? defaultOgImage : siteUrl + defaultOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={title} />
<meta property="og:url" content={siteUrl} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={defaultOgImage.startsWith('http') ? defaultOgImage : siteUrl + defaultOgImage} />
