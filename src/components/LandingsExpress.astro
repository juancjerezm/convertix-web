---
import templates from '../data/templates.json'
---

<section class="landings-express reveal" id="plantillas">
  <div class="container">
    <p class="section-label">Landings Express</p>
    <h2 class="section-title">Tu web, lista en <span class="highlight">días</span></h2>
    <p class="section-subtitle">
      Contáctame, escoge la página express que mejor se adapta a tu negocio y la personalizamos
      con tu marca. Rápido, profesional y sin complicaciones.
    </p>

    <div class="templates-grid">
      {
        templates.map((template) => (
          <article class="template-card">
            <div class="template-frame">
              <div class="template-frame-bar">
                <span class="dot" />
                <span class="dot" />
                <span class="dot" />
                <span class="frame-hint">Pasa el cursor para recorrer</span>
              </div>
              <div class="template-image">
                <picture>
                  <source srcset={template.imageFull} media="(hover: hover)" />
                  <img src={template.image} alt={template.name} class="template-preview" loading="lazy" />
                </picture>
              </div>
            </div>
            <h3 class="template-name">{template.name}</h3>
            <p class="template-description">{template.description}</p>
            <div class="template-actions">
              <a
                href={`https://wa.me/573163000208?text=${encodeURIComponent(`¡Hola! Me interesa la página express ${template.name}. ¿Podés pasarme más información?`)}`}
                class="btn btn-primary template-cta"
                target="_blank"
                rel="noopener"
              >
                Solicitar cotización &rarr;
              </a>
              {template.demoUrl && (
                <a href={template.demoUrl} class="btn btn-outline template-demo-btn">
                  Ver demo &rarr;
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .landings-express {
    text-align: center;
  }

  .landings-express .section-subtitle {
    margin: 0 auto 64px;
  }

  .landings-express .highlight {
    color: var(--accent);
  }

  .templates-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .template-card {
    padding: 32px;
    text-align: left;
  }

  .template-frame {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 24px;
  }

  .template-frame-bar {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    background: var(--bg-3);
    border-bottom: 1px solid var(--border);
  }

  .template-frame-bar .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .frame-hint {
    margin-left: auto;
    font-size: 0.68rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    display: none;
  }

  @media (hover: hover) {
    .frame-hint {
      display: inline;
    }
  }

  .template-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: 0;
    border: none;
    border-radius: 0;
    background: var(--bg-3);
  }

  .template-image picture {
    display: block;
    height: 100%;
  }

  .template-preview {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: object-position 400ms ease;
    display: block;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .template-card:hover .template-preview {
      object-position: bottom;
      transition: object-position 8s ease-in-out;
    }
  }

  .template-name {
    font-size: 1.2rem;
    margin-bottom: 12px;
  }

  .template-description {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .template-cta {
    font-size: 0.85rem;
    padding: 10px 24px;
  }

  .template-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .template-demo-btn {
    font-size: 0.85rem;
    padding: 10px 24px;
    text-align: center;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .templates-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
