---
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? ''
---

<section class="cta-final reveal" id="contacto">
  <div class="container">
    <div class="cta-card">
      <h2>Cuéntame tu proyecto</h2>
      <p>
        Contame tu idea por WhatsApp. Te respondo yo personalmente, sin
        asistente virtual ni vendedor. Sin compromiso.
      </p>
      <a href="https://wa.me/573163000208?text=%C2%A1Hola%21%20Vi%20tu%20p%C3%A1gina%20y%20quiero%20contarte%20sobre%20mi%20proyecto." class="btn btn-primary" target="_blank" rel="noopener">
        Cuéntame tu proyecto
      </a>
      <p class="cta-response-time">Respondo en menos de 2 horas</p>
    </div>

    <div class="form-alt">
      <p class="form-alt-label">¿No usás WhatsApp o preferís que te contacte yo?</p>
      <p class="form-alt-hint">Dejame tus datos y te escribo sin compromiso.</p>
      <form name="contacto" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks" class="contact-form">
        <input type="hidden" name="form-name" value="contacto" />
        <p class="hidden" style="display:none">
          <label>No llenar: <input name="bot-field" /></label>
        </p>
        <div class="form-row">
          <div class="form-group">
            <label for="nombre">Nombre</label>
            <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre" />
          </div>
          <div class="form-group">
            <label for="email">Correo electrónico</label>
            <input type="email" id="email" name="email" required placeholder="tu@correo.com" />
          </div>
        </div>
        <div class="form-group">
          <label for="mensaje">¿Qué necesitás?</label>
          <textarea id="mensaje" name="mensaje" rows="4" required placeholder="Contame brevemente tu proyecto o idea..."></textarea>
        </div>
        {turnstileKey && (
          <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="dark"></div>
        )}
        <button type="submit" class="btn btn-primary">Enviar mensaje</button>
      </form>
    </div>
  </div>
</section>

{turnstileKey && (
  <script is:inline>
    // Turnstile reads data-theme at render time — mirror the active site theme.
    (function() {
      const el = document.querySelector('.cf-turnstile');
      if (el) el.dataset.theme = document.documentElement.dataset.theme || 'dark';
    })();
  </script>
)}
{turnstileKey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<style>
  .cta-final {
    text-align: center;
  }

  .cta-card {
    max-width: 600px;
    margin: 0 auto 64px;
  }

  /* Secondary form */
  .form-alt {
    max-width: 560px;
    margin: 0 auto;
    text-align: left;
  }

  .form-alt-label {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--text);
  }

  .form-alt-hint {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .form-group input,
  .form-group textarea {
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    font-size: 0.95rem;
    font-family: inherit;
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 100px;
  }

  .contact-form .btn {
    align-self: flex-start;
    padding: 14px 36px;
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .cta-card {
      padding: 48px 24px;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .contact-form .btn {
      align-self: stretch;
    }
  }
</style>
