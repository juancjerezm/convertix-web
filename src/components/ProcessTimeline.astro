<style>
  /* ============================================
     TRAJECTORY — scroll-driven line draw
     ============================================
     A named view timeline is declared on .timeline so the fill, the spark
     and the three badges all share ONE progress value. The subject of an
     anonymous view() timeline is the animated element itself, and the fill
     is only 2px tall, so view() would map the whole draw to a 2px scroll.
     Naming the timeline on .timeline makes the section box the subject. */

  .timeline {
    view-timeline-name: --trajectory;
    view-timeline-axis: block;
  }

  .trajectory {
    position: absolute;
    top: 20px;
    /* Keep in sync with .timeline::before in global.css */
    left: calc(16.66% + 24px);
    right: calc(16.66% + 24px);
    height: 2px;
    z-index: 0;
    pointer-events: none;
    container-type: inline-size;
  }

  /* Fallback / completed state: the line is fully drawn. */
  .trajectory-fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    border-radius: 2px;
    transform: scaleX(1);
    transform-origin: left center;
  }

  /* Fallback: the spark only exists while the line draws. */
  .trajectory-spark {
    position: absolute;
    top: 1px;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px 3px var(--accent-soft);
    opacity: 0;
    transform: translateY(-50%);
  }

  /* Mobile has no timeline line by design. */
  @media (max-width: 768px) {
    .trajectory {
      display: none;
    }
  }

  @media (min-width: 769px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .trajectory-fill {
        transform: scaleX(0);
        animation: trajectory-draw linear both;
        animation-timeline: --trajectory;
        animation-range: entry 5% cover 45%;
      }

      .trajectory-spark {
        animation: trajectory-spark linear both;
        animation-timeline: --trajectory;
        animation-range: entry 5% cover 45%;
      }

      /* Badges ignite 1 -> 2 -> 3 in strict order, in sync with the
         frontier. The frontier passes half the path at cover ~23% and
         lands at cover 45%, where the draw ends. */
      .timeline-step::before {
        animation: badge-ignite linear both;
        animation-timeline: --trajectory;
      }

      .timeline-step[data-number="1"]::before {
        animation-range: cover 0% cover 8%;
      }

      .timeline-step[data-number="2"]::before {
        animation-range: cover 17% cover 29%;
      }

      .timeline-step[data-number="3"]::before {
        animation-range: cover 37% cover 50%;
      }
    }
  }

  @keyframes trajectory-draw {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @keyframes trajectory-spark {
    0% {
      opacity: 0;
      transform: translateX(0) translateY(-50%);
    }

    8% {
      opacity: 1;
    }

    90% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateX(calc(100cqw - 50%)) translateY(-50%);
    }
  }

  @keyframes badge-ignite {
    0% {
      transform: translateX(-50%) scale(1);
      border-color: var(--border);
      background: var(--bg-2);
    }

    45% {
      transform: translateX(-50%) scale(1.12);
      border-color: var(--accent);
      background: var(--accent-soft);
    }

    100% {
      transform: translateX(-50%) scale(1);
      border-color: var(--accent);
      background: var(--accent-soft);
    }
  }
</style>