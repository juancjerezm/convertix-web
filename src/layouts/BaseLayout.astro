---
import '@fontsource-variable/inter'
import '@fontsource-variable/space-grotesk'
import '@fontsource-variable/jetbrains-mono'
import '../styles/global.css'
import Backdrop from '../components/Backdrop.astro'
import Footer from '../components/Footer.astro'
import Navbar from '../components/Navbar.astro'
import SEO from '../components/SEO.astro'
import StructuredData from '../components/StructuredData.astro'

export interface Props {
  title?: string
  description?: string
  ogImage?: string
  url?: string
}

const {
  title = 'Convertix Web | Páginas Web, Chatbots con IA y Automatizaciones en Colombia',
  description = 'Landing pages, chatbots con inteligencia artificial y automatizaciones para tu negocio en Colombia. Desarrollo web rápido, sin vueltas. Escríbeme.',
  ogImage,
  url
} = Astro.props
---

<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Theme + JS capability flags: must run before first paint -->
    <script is:inline>
      (function() {
        document.documentElement.classList.add('js');
        const saved = localStorage.getItem('theme');
        if (saved === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        } else if (!saved && window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <SEO title={title} description={description} ogImage={ogImage} url={url} />
    <StructuredData url={url} />
    <slot name="head" />
  </head>
  <body>
    <!-- Scroll progress bar -->
    <div class="scroll-progress" id="scroll-progress"></div>
    <!-- Static decorative backdrop (aria-hidden, no JS) -->
    <Backdrop />
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      const bar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', () => {
        const scrollTop = document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
        bar.style.width = progress + '%';
      });
    </script>
  </body>
</html>

<style is:global>
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: var(--accent);
    z-index: 10000;
    transition: width 50ms linear;
  }
</style>
